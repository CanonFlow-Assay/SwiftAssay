{
  "schema": "assay-playground-requirements/0.1",
  "application": "ExpenseGuard",
  "scope": "Integer cents in USD; no reimbursement, provider, transport or real payment.",
  "requirements": [
    {
      "id": "R1",
      "text": "Nonpositive approval limits are invalid policy."
    },
    {
      "id": "R2",
      "text": "Amounts must be strictly positive integer cents."
    },
    {
      "id": "R3",
      "text": "Only USD is supported."
    },
    {
      "id": "R4",
      "text": "Memo must contain a non-whitespace character."
    },
    {
      "id": "R5",
      "text": "Amounts at or below the limit are approved; larger amounts require review."
    }
  ],
  "precedence": [
    "R1",
    "R2",
    "R3",
    "R4",
    "R5"
  ],
  "selections": {
    "baseline": [
      "approved",
      "negative",
      "over-limit",
      "currency",
      "empty-memo",
      "zero-policy"
    ],
    "expanded": [
      "approved",
      "negative",
      "over-limit",
      "currency",
      "empty-memo",
      "zero-policy",
      "zero-amount",
      "exact-limit",
      "smallest-amount",
      "blank-memo",
      "negative-policy",
      "large-amount"
    ]
  },
  "cases": [
    {
      "id": "approved",
      "requirement": "R5",
      "amount": 2500,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Approved",
        "amount": 2500,
        "reason": ""
      }
    },
    {
      "id": "negative",
      "requirement": "R2",
      "amount": -1,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "amount"
      }
    },
    {
      "id": "over-limit",
      "requirement": "R5",
      "amount": 10001,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "NeedsReview",
        "amount": 10001,
        "reason": ""
      }
    },
    {
      "id": "currency",
      "requirement": "R3",
      "amount": 2500,
      "currency": "EUR",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "currency"
      }
    },
    {
      "id": "empty-memo",
      "requirement": "R4",
      "amount": 2500,
      "currency": "USD",
      "memo": "",
      "limit": 10000,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "memo"
      }
    },
    {
      "id": "zero-policy",
      "requirement": "R1",
      "amount": 2500,
      "currency": "USD",
      "memo": "lunch",
      "limit": 0,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "policy"
      }
    },
    {
      "id": "zero-amount",
      "requirement": "R2",
      "amount": 0,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "amount"
      }
    },
    {
      "id": "exact-limit",
      "requirement": "R5",
      "amount": 10000,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Approved",
        "amount": 10000,
        "reason": ""
      }
    },
    {
      "id": "smallest-amount",
      "requirement": "R2",
      "amount": 1,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "Approved",
        "amount": 1,
        "reason": ""
      }
    },
    {
      "id": "blank-memo",
      "requirement": "R4",
      "amount": 2500,
      "currency": "USD",
      "memo": " \t",
      "limit": 10000,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "memo"
      }
    },
    {
      "id": "negative-policy",
      "requirement": "R1",
      "amount": 2500,
      "currency": "USD",
      "memo": "lunch",
      "limit": -1,
      "expected": {
        "kind": "Invalid",
        "amount": 0,
        "reason": "policy"
      }
    },
    {
      "id": "large-amount",
      "requirement": "R5",
      "amount": 2147483647,
      "currency": "USD",
      "memo": "lunch",
      "limit": 10000,
      "expected": {
        "kind": "NeedsReview",
        "amount": 2147483647,
        "reason": ""
      }
    }
  ]
}
