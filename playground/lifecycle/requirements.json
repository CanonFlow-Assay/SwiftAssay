{
  "schema": "expenseguard-requirements/0.2",
  "application": "ExpenseGuard",
  "scope": "Integer cents in USD; no reimbursement, provider, transport or real payment.",
  "requirements": [
    {
      "id": "R1",
      "text": "Nonpositive approval limits are invalid policy."
    },
    {
      "id": "R2",
      "text": "Amounts must be strictly positive integer cents."
    },
    {
      "id": "R3",
      "text": "Only USD is supported."
    },
    {
      "id": "R4",
      "text": "Memo must contain a non-whitespace character."
    },
    {
      "id": "R5",
      "text": "Amounts at or below the limit are approved; larger amounts require review."
    },
    {
      "id": "R6",
      "text": "After R1-R4 validation, reject nonblank memos longer than200Unicode scalar values with memo-too-long.",
      "maxMemoScalars": 200
    }
  ],
  "precedence": [
    "R1",
    "R2",
    "R3",
    "R4",
    "R6",
    "R5"
  ],
  "selections": {
    "frozenBaseline": [
      "approved",
      "negative",
      "over-limit",
      "currency",
      "empty-memo",
      "zero-policy",
      "zero-amount",
      "exact-limit",
      "smallest-amount",
      "blank-memo",
      "negative-policy",
      "large-amount"
    ],
    "candidate": [
      "approved",
      "negative",
      "over-limit",
      "currency",
      "empty-memo",
      "zero-policy",
      "zero-amount",
